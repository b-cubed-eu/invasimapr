# Local development directory (figures, docx, case study, climate rasters) - not pushed
dev/

# README/man figures ARE tracked so images render on GitHub and pkgdown.
# (do not ignore man/figures/ or vignettes/figures/)
inst/doc/

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# macOS
.DS_Store

# translation temp files
po/*~

# RStudio Connect folder
rsc

# Generated README HTML (GitHub renders README.md, not .html)
/README.html

# Vignette data cache is regenerable; keep only the canonical prebuilt inputs
vignettes/_data/*
!vignettes/_data/invasimapr_vignettes.rds
